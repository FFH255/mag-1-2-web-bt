                        "example": "12345",
                        "description": "Пароль для авторизации в модуле антифрода",
                        "name": "password",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Антифрод-ключ",
                        "schema": {
                            "$ref": "#/definitions/AntifroadKeyGetHandler.ResponseBody"
                        }
                    },
                    "400": {
                        "description": "Отсутствуем пароль",
